# Backend
PORT=3001
NODE_ENV=development

# Blockchain (local Hardhat by default)
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Contract Addresses (set after deployment)
# USER_REGISTRY_ADDRESS=0x...
# RECORD_MANAGER_ADDRESS=0x...
# ACCESS_CONTROL_ADDRESS=0x...
# EMERGENCY_ACCESS_ADDRESS=0x...

# Custodian Emergency Service
# The private key of the Custodian wallet (deployer/owner of EmergencyAccess contract)
# Required for auto-validation of emergency access requests
# CUSTODIAN_PRIVATE_KEY=0x...

# Set to "true" to auto-start the emergency event listener on backend startup
# AUTO_START_EMERGENCY_LISTENER=true

# Optional: Sepolia testnet deployment
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# SEPOLIA_PRIVATE_KEY=your_private_key
